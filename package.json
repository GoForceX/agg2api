{
  "name": "agg2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "demo": "bun run scripts/demo.ts",
    "build": "bun build --compile --outfile dist/agg2api src/main.ts",
    "build:web": "cd web && bun install && bun run build",
    "affinity": "bun run scripts/affinity.ts",
    "tutorial": "bun run scripts/tutorial-check.ts",
    "failover": "bun run scripts/failover.ts",
    "breaker-share": "bun run scripts/breaker-share.ts",
    "route-strategy": "bun run scripts/route-strategy.ts",
    "ui-check": "bun run scripts/ui-check.ts"
  },
  "dependencies": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.2",
    "@effect/platform-bun": "0.91.2",
    "@effect/sql": "0.52.1",
    "@effect/sql-sqlite-bun": "0.53.0",
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
